# Copiar para .env.local e preencher. Nunca versionar o ficheiro preenchido.
# Só valores PÚBLICOS podem ter o prefixo VITE_ (vão para o bundle do navegador).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# ---------------------------------------------------------------------------
# Segredos: NÃO colocar aqui com prefixo VITE_. Guardar em GitHub Secrets,
# nos secrets das Edge Functions do Supabase ou num gestor de segredos.
# Listados apenas para documentação.
# ---------------------------------------------------------------------------
# SUPABASE_DB_URL=REPLACE_ME
# SUPABASE_ACCESS_TOKEN=REPLACE_ME
# R2_ACCOUNT_ID=REPLACE_ME
# R2_ACCESS_KEY_ID=REPLACE_ME
# R2_SECRET_ACCESS_KEY=REPLACE_ME
# R2_BUCKET_NAME=REPLACE_ME
# BACKUP_ENCRYPTION_RECIPIENT=REPLACE_ME

# Testes: Postgres descartável para o teste de concorrência (opcional).
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
